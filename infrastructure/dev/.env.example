# ==========================================
# Hybrid Local/Cloud Dev Environment Config
# ==========================================

# 1. Cloud Database (Neon Serverless PostgreSQL)
# Thay thế chuỗi này bằng Connection String thực tế từ Neon Console của bạn.
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-endpoint>:5432/comicverse?sslmode=require
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>

# 2. Redis (Local Docker)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# 3. RabbitMQ (Local Docker)
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# 4. Eureka Service Registry (Local Docker)
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
